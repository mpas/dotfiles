# -----------------------------------------------------------------------------
# Generic Configuration
# -----------------------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
# macos-titlebar-style = hidden

# -----------------------------------------------------------------------------
# Look and Feel
# -----------------------------------------------------------------------------
adjust-cell-height = 1
background = #1a1a1a
background-blur = 16
background-opacity = 0.85
font-size = 16
font-thicken = true
font-thicken-strength = 1

# -----------------------------------------------------------------------------
# Quick Terminal
# -----------------------------------------------------------------------------
quick-terminal-animation-duration = 0
quick-terminal-position = center
quick-terminal-size = 50%,50%

keybind = ctrl+apostrophe=toggle_quick_terminal

# -----------------------------------------------------------------------------
# Tab
# -----------------------------------------------------------------------------
# New/Close
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab

# Navigate
keybind = ctrl+h=previous_tab
keybind = ctrl+l=next_tab
# Below has been commented, i am trying to use the defaults with command key
# keybind = ctrl+1=goto_tab:1
# keybind = ctrl+2=goto_tab:2
# keybind = ctrl+3=goto_tab:3
# keybind = ctrl+4=goto_tab:4
# keybind = ctrl+5=goto_tab:5
# keybind = ctrl+6=goto_tab:6
# keybind = ctrl+7=goto_tab:7
# keybind = ctrl+8=goto_tab:8
# keybind = ctrl+9=goto_tab:9

# Move
keybind = ctrl+shift+left=move_tab:-1
keybind = ctrl+shift+right=move_tab:1

# Rename
keybind = ctrl+shift+r=prompt_tab_title

# -----------------------------------------------------------------------------
# Split
# -----------------------------------------------------------------------------
# Appearance
split-divider-color = #3b82c4
unfocused-split-opacity = 0.50
unfocused-split-fill = #000000

# Navigate
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Resize
keybind = alt+shift+h=resize_split:left,20
keybind = alt+shift+j=resize_split:down,20
keybind = alt+shift+k=resize_split:up,20
keybind = alt+shift+l=resize_split:right,20

# Zoom
keybind = alt+z=toggle_split_zoom
